# Brevo: https://app.brevo.com/ → SMTP & API → створити SMTP key
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-login-email@example.com
BREVO_SMTP_KEY=xkeysib-xxxx

# Відправник — має бути підтверджений у Brevo (Marketing → Senders або Campaigns → налаштування)
MAIL_FROM="Your Name <your-login-email@example.com>"

# Куди приходять повідомлення з форми
MAIL_TO=your-inbox@example.com

PORT=1337
SESSION_SECRET=change-me-to-a-random-string
